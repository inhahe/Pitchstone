<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up the notes database and settings, not caches. -->
<full-backup-content>
    <include domain="database" path="inkdown.db" />
    <include domain="database" path="inkdown.db-wal" />
    <include domain="database" path="inkdown.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
