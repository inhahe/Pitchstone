<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: notes and settings go to cloud backup and to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="pitchstone.db" />
        <include domain="database" path="pitchstone.db-wal" />
        <include domain="database" path="pitchstone.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pitchstone.db" />
        <include domain="database" path="pitchstone.db-wal" />
        <include domain="database" path="pitchstone.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
